[user]
    name = Ryan Kaskel
    email = dev@ryankaskel.com
    useconfigonly = true
    signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIBZpom85x6RZxHC5uF8YXSQngWSqh+cotSc66XlJ7o9H

[core]
    whitespace = cr-at-eol

[init]
	defaultBranch = main

[commit]
	gpgsign = true

[pull]
	ff = only

[alias]
    st = status
    sts = status -s
    stb = status -s -b
    cam = commit -am
    fp = fetch -p
    br = branch
    co = checkout
    df = diff
    rb = rebase
    rbi = rebase -i
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset'
    last = cat-file commit HEAD

[color "branch"]
    current = yellow bold
    local = yellow
    remote = green
    upstream = cyan

[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold

[color "status"]
    added = yellow
    changed = green
    untracked = cyan

[gpg]
	format = ssh

[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential

[include]
    path = config.local
