## Basic settings
set autoindent
set constantshow
set linenumbers
set minibar
set nohelp
set numbercolor #555,#eee
set smarthome
set softwrap
set stateflags
set tabsize 4
set tabstospaces
set titlecolor #000,#ccc

## Keybindings
# Copy the marked text (or the whole buffer) to the system clipboard over
# OSC 52.  From nano's sample.nanorc; || needs nano 8.7 or later.
bind M-* "{execute}|| printf "\033]52;c;%s\007" "$(base64 | tr -d '\n')" {enter}{undo}" main
bind M-/ redo main
bind M-< firstline main
bind M-> lastline main
bind M-b prevword main
bind M-d chopwordright main
bind M-f nextword main
bind M-g gotoline main
bind M-v pageup main
bind M-w copy main
bind M-x execute main
bind ^A home main
bind ^B left main
bind ^D delete main
bind ^E end main
bind ^F right main
bind ^G cancel all
bind ^H help main
bind ^K cut main
bind ^L refresh main
bind ^N down main
bind ^O writeout main
bind ^P up main
bind ^Q exit main
bind ^R wherewas main
bind ^S whereis main
bind ^Space mark main
bind ^V pagedown main
bind ^W chopwordleft main
bind ^Y paste main
bind ^_ undo main
unbind ^X all
