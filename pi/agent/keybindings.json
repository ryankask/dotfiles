{
  "$schema": "https://pi.dev/schemas/keybindings.schema.json",
  "tui.editor.cursorUp": ["up", "ctrl+p"],
  "tui.editor.cursorDown": ["down", "ctrl+n"],
  "tui.editor.pageUp": ["pageUp", "alt+v"],
  "tui.editor.pageDown": ["pageDown", "ctrl+v"],
  "tui.editor.historyPrevious": ["alt+p"],
  "tui.editor.historyNext": ["alt+n"],
  "tui.editor.undo": ["ctrl+-", "ctrl+/"],
  "tui.select.up": ["up", "ctrl+p"],
  "tui.select.down": ["down", "ctrl+n"],
  "tui.select.pageUp": ["pageUp", "alt+v"],
  "tui.select.pageDown": ["pageDown", "ctrl+v"],
  "tui.select.cancel": ["escape", "ctrl+c", "ctrl+g"],
  "tui.altScreen.pageUp": ["pageUp", "alt+v"],
  "tui.altScreen.pageDown": ["pageDown", "ctrl+v"],
  "tui.altScreen.searchNext": ["enter"],
  "tui.altScreen.searchClose": ["escape", "ctrl+g"],
  "app.interrupt": ["escape", "ctrl+g"],
  "app.clipboard.pasteImage": ["alt+i"],
  "app.session.togglePath": ["ctrl+."],
  "app.session.toggleNamedFilter": [],
  "app.thinking.toggle": [],
  "app.tools.expand": ["alt+o"],
  "app.model.select": [],
  "app.editor.external": [],
  "app.model.cycleForward": ["ctrl+]"],
  "app.model.cycleBackward": ["ctrl+["],
  "app.models.toggleProvider": ["ctrl+."]
}
