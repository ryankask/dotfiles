# -*- mode: sh; -*-
#
# Executes commands at login pre-zshrc.
#
# Authors:
#   Sorin Ionescu <sorin.ionescu@gmail.com>
#

#
# Browser
#

if [[ "$OSTYPE" == darwin* ]]; then
  export BROWSER='open'
fi

#
# Editors
#

export EDITOR='emacs'
export VISUAL='emacs'
export PAGER='less'

#
# Language
#

if [[ -z "$LANG" ]]; then
  export LANG='en_GB.UTF-8'
fi

#
# Paths
#

export DOTFILES="${${(%):-%x}:A:h:h}"
export GOPATH="$HOME/go"
if [[ $CPUTYPE == "arm64" ]]; then
  export BREW_PREFIX="/opt/homebrew"
  if [[ -d "/opt/workbrew" ]]; then
    export WORK_DEVICE=1
  fi
else
  export BREW_PREFIX="/usr/local"
fi
if [[ -d /usr/local/Android/sdk ]]; then
  export ANDROID_HOME="/usr/local/Android/sdk"
fi

# Ensure path arrays do not contain duplicates.
typeset -gU cdpath fpath mailpath path

# Set the list of directories that Zsh searches for programs.  (N-/) drops
# a directory that doesn't exist on this machine.
path=(
  $HOME/.local/bin(N-/)
  $GOPATH/bin(N-/)
  $HOME/.cargo/bin(N-/)
  $HOME/.cabal/bin(N-/)
  $HOME/.ghcup/bin(N-/)
  /opt/local/google-cloud-sdk/bin(N-/)
  ${WORK_DEVICE:+/opt/workbrew/bin}
  $BREW_PREFIX/opt/coreutils/libexec/gnubin(N-/)
  $BREW_PREFIX/{bin,sbin}(N-/)
  /usr/local/{bin,sbin}(N-/)
  $path
)

#
# Less
#

# Set the default Less options.
# Mouse-wheel scrolling has been disabled by -X (disable screen clearing).
# Remove -X and -F (exit if the content fits on one screen) to enable it.
export LESS='-F -g -i -M -R -w -X -z-4'
