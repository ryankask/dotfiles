<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.ryankaskel.brew.syncthing</string>
	<key>LimitLoadToSessionType</key>
	<array>
		<string>Aqua</string>
		<string>Background</string>
		<string>LoginWindow</string>
		<string>StandardIO</string>
		<string>System</string>
	</array>
	<key>ProgramArguments</key>
	<array>
	  <string>/Users/ryan.k/.local/bin/syncthing</string>
		<string>--no-browser</string>
		<string>--no-restart</string>
		<string>--log-file=/Users/ryan.k/.local/syncthing/syncthing.log</string>
		<string>--log-max-size=10485760</string>
		<string>--log-max-old-files=3</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<!-- syncthing writes and rotates its own log file; stdout repeats it. -->
	<key>StandardErrorPath</key>
	<string>/Users/ryan.k/.local/syncthing/stderr.log</string>
	<key>StandardOutPath</key>
	<string>/dev/null</string>
</dict>
</plist>
